# Google Search Console API configuration for scripts/gsc_positions.py
# Copy to .env (which is gitignored) and fill in your paths.
# Get GSC_CLIENT_SECRETS_PATH from Google Cloud Console:
#   APIs & Services > Credentials > Create Credentials > OAuth client ID
#   (application type: Desktop app), then Download JSON.
# Enable the Search Console API on that project first:
#   APIs & Services > Library > Search Console API > Enable.
# Add https://www.googleapis.com/auth/webmasters.readonly as the only scope.

# Your verified Search Console property.
# Use sc-domain:buildsyourmind.in if you verified the DOMAIN property,
# or https://buildsyourmind.in/ if you verified the URL-prefix property.
GSC_SITE_URL=sc-domain:buildsyourmind.in

# OAuth client JSON downloaded from Google Cloud Console (Desktop app).
GSC_CLIENT_SECRETS_PATH=/home/ayush-upadhyay/Downloads/gsc_client_secret.json

# Where the script saves your OAuth token after the first browser sign-in
# (outside the repo on purpose). Keep this file private - it is a credential.
GSC_TOKEN_PATH=/home/ayush-upadhyay/.gsc_token.json

# Master SEO sheet.
SHEET_PATH=/home/ayush-upadhyay/Downloads/Builds_Your_Mind_Website_SEO_Sheet.xlsx

# Look-back window in days.
DAYS=28
